# Copy to aria/.env and fill in your provider key.
#   cp aria/.env.example aria/.env
#
# Easiest cloud/laptop path: a hosted provider that serves open-source models
# over an OpenAI-compatible API (no GPU to manage). Default below is Together AI.

ARIA_LLM_BACKEND=openai
ARIA_EMBED_BACKEND=openai
ARIA_API_BASE_URL=https://api.together.xyz/v1
ARIA_API_KEY=

# Open-source model ids (as named by the provider).
ARIA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
ARIA_EMBED_MODEL=BAAI/bge-large-en-v1.5

# Index lives here inside the container (mapped to a Docker volume).
ARIA_DATA_DIR=/data
